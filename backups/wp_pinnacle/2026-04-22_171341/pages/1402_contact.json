  "content": "<!-- wp:cover {\"overlayColor\":\"primary\",\"minHeight\":420,\"minHeightUnit\":\"px\",\"contentPosition\":\"center center\",\"isDark\":true,\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"70px\",\"bottom\":\"70px\",\"left\":\"20px\",\"right\":\"20px\"}}}} -->\n<div class=\"wp-block-cover alignfull is-light\" style=\"padding-top:70px;padding-right:20px;padding-bottom:70px;padding-left:20px;min-height:420px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-primary-background-color has-background-dim-100 has-background-dim\" style=\"background:linear-gradient(135deg,#0D3B2E 0%,#1A4E3C 50%,#0D3B2E 100%)\"></span><div class=\"wp-block-cover__inner-container\">\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":1,\"style\":{\"typography\":{\"fontSize\":\"46px\",\"lineHeight\":\"1.15\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#FFFFFF\"},\"spacing\":{\"margin\":{\"bottom\":\"18px\"}}}} -->\n<h1 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#FFFFFF;margin-bottom:18px;font-size:46px;font-style:normal;font-weight:700\">Let's Talk About<br><span style=\"color:#C9A84C\">Your Property</span></h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"20px\",\"lineHeight\":\"1.5\"},\"color\":{\"text\":\"#F5F0E8\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#F5F0E8;font-size:20px;line-height:1.5\">Reach out by phone, email, or the form below. We respond within <strong style=\"color:#C9A84C\">24 hours</strong> — usually much faster.</p>\n<!-- /wp:paragraph -->\n</div></div>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"70px\",\"bottom\":\"40px\",\"left\":\"20px\",\"right\":\"20px\"}},\"color\":{\"background\":\"#FFFFFF\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1200px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#FFFFFF;padding-top:70px;padding-right:20px;padding-bottom:40px;padding-left:20px\">\n<!-- wp:heading {\"textAlign\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"36px\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#0D3B2E\"},\"spacing\":{\"margin\":{\"bottom\":\"50px\"}}}} -->\n<h2 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#0D3B2E;margin-bottom:50px;font-size:36px;font-style:normal;font-weight:700\">Three Ways to Reach Us</h2>\n<!-- /wp:heading -->\n\n<!-- wp:columns {\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide\">\n<!-- wp:column {\"style\":{\"spacing\":{\"padding\":{\"top\":\"40px\",\"bottom\":\"40px\",\"left\":\"30px\",\"right\":\"30px\"}},\"color\":{\"background\":\"#F5F0E8\"},\"border\":{\"radius\":\"12px\",\"color\":\"#C9A84C\",\"width\":\"2px\"}}} -->\n<div class=\"wp-block-column has-border-color has-background\" style=\"border-color:#C9A84C;border-width:2px;border-radius:12px;background-color:#F5F0E8;padding-top:40px;padding-right:30px;padding-bottom:40px;padding-left:30px\">\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"48px\"}}} -->\n<p class=\"has-text-align-center\" style=\"font-size:48px\">📞</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":3,\"style\":{\"typography\":{\"fontSize\":\"22px\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#0D3B2E\"}}} -->\n<h3 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#0D3B2E;font-size:22px;font-style:normal;font-weight:700\">Call Us</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"22px\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#0D3B2E\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#0D3B2E;font-size:22px;font-style:normal;font-weight:700\"><a href=\"tel:19207779886\" style=\"color:#0D3B2E;text-decoration:none\">(920) 777-9886</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"color\":{\"text\":\"#555555\"},\"typography\":{\"fontSize\":\"15px\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#555555;font-size:15px\">Mon–Fri 8am–7pm CST<br>Sat–Sun 9am–5pm CST</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"style\":{\"spacing\":{\"padding\":{\"top\":\"40px\",\"bottom\":\"40px\",\"left\":\"30px\",\"right\":\"30px\"}},\"color\":{\"background\":\"#F5F0E8\"},\"border\":{\"radius\":\"12px\",\"color\":\"#C9A84C\",\"width\":\"2px\"}}} -->\n<div class=\"wp-block-column has-border-color has-background\" style=\"border-color:#C9A84C;border-width:2px;border-radius:12px;background-color:#F5F0E8;padding-top:40px;padding-right:30px;padding-bottom:40px;padding-left:30px\">\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"48px\"}}} -->\n<p class=\"has-text-align-center\" style=\"font-size:48px\">✉️</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":3,\"style\":{\"typography\":{\"fontSize\":\"22px\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#0D3B2E\"}}} -->\n<h3 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#0D3B2E;font-size:22px;font-style:normal;font-weight:700\">Email</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"18px\",\"fontWeight\":\"600\"},\"color\":{\"text\":\"#0D3B2E\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#0D3B2E;font-size:18px;font-style:normal;font-weight:600\"><a href=\"mailto:deals@pinnaclegroupwi.com\" style=\"color:#0D3B2E;text-decoration:none\">deals@pinnaclegroupwi.com</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"color\":{\"text\":\"#555555\"},\"typography\":{\"fontSize\":\"15px\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#555555;font-size:15px\">Replies within 24 hours<br>Often same day</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"style\":{\"spacing\":{\"padding\":{\"top\":\"40px\",\"bottom\":\"40px\",\"left\":\"30px\",\"right\":\"30px\"}},\"color\":{\"background\":\"#F5F0E8\"},\"border\":{\"radius\":\"12px\",\"color\":\"#C9A84C\",\"width\":\"2px\"}}} -->\n<div class=\"wp-block-column has-border-color has-background\" style=\"border-color:#C9A84C;border-width:2px;border-radius:12px;background-color:#F5F0E8;padding-top:40px;padding-right:30px;padding-bottom:40px;padding-left:30px\">\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"48px\"}}} -->\n<p class=\"has-text-align-center\" style=\"font-size:48px\">📍</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":3,\"style\":{\"typography\":{\"fontSize\":\"22px\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#0D3B2E\"}}} -->\n<h3 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#0D3B2E;font-size:22px;font-style:normal;font-weight:700\">Visit Us</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"16px\",\"fontWeight\":\"600\"},\"color\":{\"text\":\"#0D3B2E\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#0D3B2E;font-size:16px;font-style:normal;font-weight:600\">735 E Walnut St, Suite 3<br>Green Bay, WI 54301</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"color\":{\"text\":\"#555555\"},\"typography\":{\"fontSize\":\"15px\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#555555;font-size:15px\">By appointment<br>Free parking on site</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n</div>\n<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"anchor\":\"contact-form\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"60px\",\"bottom\":\"80px\",\"left\":\"20px\",\"right\":\"20px\"}},\"color\":{\"background\":\"#F5F0E8\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"760px\"}} -->\n<div id=\"contact-form\" class=\"wp-block-group alignfull has-background\" style=\"background-color:#F5F0E8;padding-top:60px;padding-right:20px;padding-bottom:80px;padding-left:20px\">\n<!-- wp:heading {\"textAlign\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"36px\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#0D3B2E\"},\"spacing\":{\"margin\":{\"bottom\":\"15px\"}}}} -->\n<h2 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#0D3B2E;margin-bottom:15px;font-size:36px;font-style:normal;font-weight:700\">Send Us a Message</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"18px\"},\"color\":{\"text\":\"#555555\"},\"spacing\":{\"margin\":{\"bottom\":\"35px\"}}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#555555;margin-bottom:35px;font-size:18px\">Tell us about your property and timeline. No obligation, no pressure.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:shortcode -->\n[contact-form-7 id=\"1606\" title=\"Quote\"]\n<!-- /wp:shortcode -->\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"70px\",\"bottom\":\"70px\",\"left\":\"20px\",\"right\":\"20px\"}},\"color\":{\"background\":\"#0D3B2E\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"900px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#0D3B2E;padding-top:70px;padding-right:20px;padding-bottom:70px;padding-left:20px\">\n<!-- wp:heading {\"textAlign\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"32px\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#FFFFFF\"},\"spacing\":{\"margin\":{\"bottom\":\"20px\"}}}} -->\n<h2 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#FFFFFF;margin-bottom:20px;font-size:32px;font-style:normal;font-weight:700\">What Happens After You Reach Out?</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"18px\"},\"color\":{\"text\":\"#F5F0E8\"},\"spacing\":{\"margin\":{\"bottom\":\"40px\"}}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#F5F0E8;margin-bottom:40px;font-size:18px\">No surprise sales tactics. Here's exactly what to expect:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"style\":{\"typography\":{\"fontSize\":\"17px\",\"lineHeight\":\"2\"},\"color\":{\"text\":\"#F5F0E8\"}}} -->\n<ul class=\"has-text-color\" style=\"color:#F5F0E8;font-size:17px;line-height:2\"><!-- wp:list-item -->\n<li><strong style=\"color:#C9A84C\">1. Quick chat</strong> — 5–10 minutes about your property and situation.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><strong style=\"color:#C9A84C\">2. Free walkthrough</strong> — in person or virtual, your choice.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><strong style=\"color:#C9A84C\">3. Cash offer in 24 hours</strong> — written, no obligation.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><strong style=\"color:#C9A84C\">4. You decide</strong> — accept, negotiate, or walk away. Zero pressure.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"60px\",\"bottom\":\"60px\",\"left\":\"20px\",\"right\":\"20px\"}},\"color\":{\"background\":\"#1A1A1A\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#1A1A1A;padding-top:60px;padding-right:20px;padding-bottom:60px;padding-left:20px\">\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":3,\"style\":{\"typography\":{\"fontSize\":\"28px\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#FFFFFF\"}}} -->\n<h3 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#FFFFFF;font-size:28px;font-style:normal;font-weight:700\">Prefer to talk right now?</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"18px\"},\"color\":{\"text\":\"#C9A84C\"},\"spacing\":{\"margin\":{\"bottom\":\"30px\"}}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#C9A84C;margin-bottom:30px;font-size:18px\">We answer Mon–Fri 8am–7pm CST. After hours, leave a voicemail and we call back same day.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"backgroundColor\":\"secondary\",\"textColor\":\"primary\",\"style\":{\"border\":{\"radius\":\"30px\"},\"typography\":{\"fontSize\":\"18px\",\"fontWeight\":\"700\"},\"spacing\":{\"padding\":{\"top\":\"16px\",\"bottom\":\"16px\",\"left\":\"36px\",\"right\":\"36px\"}}}} -->\n<div class=\"wp-block-button has-custom-font-size\" style=\"font-size:18px;font-style:normal;font-weight:700\"><a class=\"wp-block-button__link has-primary-color has-secondary-background-color has-text-color has-background has-link-color wp-element-button\" href=\"tel:19207779886\" style=\"border-radius:30px;padding-top:16px;padding-right:36px;padding-bottom:16px;padding-left:36px\">📞 Call (920) 777-9886</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"textColor\":\"secondary\",\"style\":{\"border\":{\"radius\":\"30px\",\"color\":\"#C9A84C\",\"width\":\"2px\"},\"typography\":{\"fontSize\":\"18px\",\"fontWeight\":\"700\"},\"spacing\":{\"padding\":{\"top\":\"14px\",\"bottom\":\"14px\",\"left\":\"34px\",\"right\":\"34px\"}},\"color\":{\"background\":\"transparent\"}}} -->\n<div class=\"wp-block-button has-custom-font-size\" style=\"font-size:18px;font-style:normal;font-weight:700\"><a class=\"wp-block-button__link has-secondary-color has-text-color has-background has-link-color wp-element-button\" href=\"sms:19207779886\" style=\"border-color:#C9A84C;border-width:2px;border-radius:30px;background:transparent;padding-top:14px;padding-right:34px;padding-bottom:14px;padding-left:34px\">💬 Text Us</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n</div>\n<!-- /wp:group -->\n",
