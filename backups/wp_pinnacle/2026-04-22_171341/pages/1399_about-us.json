  "content": "<!-- wp:cover {\"overlayColor\":\"primary\",\"minHeight\":480,\"minHeightUnit\":\"px\",\"contentPosition\":\"center center\",\"isDark\":true,\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"70px\",\"bottom\":\"70px\",\"left\":\"20px\",\"right\":\"20px\"}}}} -->\n<div class=\"wp-block-cover alignfull is-light\" style=\"padding-top:70px;padding-right:20px;padding-bottom:70px;padding-left:20px;min-height:480px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-primary-background-color has-background-dim-100 has-background-dim\" style=\"background:linear-gradient(135deg,#0D3B2E 0%,#1A4E3C 50%,#0D3B2E 100%)\"></span><div class=\"wp-block-cover__inner-container\">\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":1,\"style\":{\"typography\":{\"fontSize\":\"46px\",\"lineHeight\":\"1.15\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#FFFFFF\"},\"spacing\":{\"margin\":{\"bottom\":\"20px\"}}}} -->\n<h1 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#FFFFFF;margin-bottom:20px;font-size:46px;font-style:normal;font-weight:700\">Local Roots. Honest Offers.<br><span style=\"color:#C9A84C\">Trusted Partners.</span></h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"20px\",\"lineHeight\":\"1.5\"},\"color\":{\"text\":\"#F5F0E8\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#F5F0E8;font-size:20px;line-height:1.5\">We buy houses in any condition, helping Wisconsin homeowners find a fresh start without the stress of traditional real estate.</p>\n<!-- /wp:paragraph -->\n</div></div>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"70px\",\"bottom\":\"70px\",\"left\":\"20px\",\"right\":\"20px\"}},\"color\":{\"background\":\"#FFFFFF\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"900px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#FFFFFF;padding-top:70px;padding-right:20px;padding-bottom:70px;padding-left:20px\">\n<!-- wp:heading {\"textAlign\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"36px\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#0D3B2E\"},\"spacing\":{\"margin\":{\"bottom\":\"20px\"}}}} -->\n<h2 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#0D3B2E;margin-bottom:20px;font-size:36px;font-style:normal;font-weight:700\">Serving Green Bay and Beyond</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"18px\",\"lineHeight\":\"1.7\"},\"color\":{\"text\":\"#333333\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#333333;font-size:18px;line-height:1.7\">We specialize in helping homeowners who need to sell 'as-is' — whether you're facing probate, moving for a job, or simply don't want to deal with the headache of repairs and realtor commissions. From <strong style=\"color:#0D3B2E\">Brown County</strong> to <strong style=\"color:#0D3B2E\">Outagamie County</strong>, we know the local market because <em>we live and work here</em>.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"70px\",\"bottom\":\"70px\",\"left\":\"20px\",\"right\":\"20px\"}},\"color\":{\"background\":\"#F5F0E8\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1200px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#F5F0E8;padding-top:70px;padding-right:20px;padding-bottom:70px;padding-left:20px\">\n<!-- wp:heading {\"textAlign\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"36px\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#0D3B2E\"},\"spacing\":{\"margin\":{\"bottom\":\"50px\"}}}} -->\n<h2 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#0D3B2E;margin-bottom:50px;font-size:36px;font-style:normal;font-weight:700\">What Sets Us Apart</h2>\n<!-- /wp:heading -->\n\n<!-- wp:columns {\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide\">\n<!-- wp:column {\"style\":{\"spacing\":{\"padding\":{\"top\":\"35px\",\"bottom\":\"35px\",\"left\":\"30px\",\"right\":\"30px\"}},\"color\":{\"background\":\"#FFFFFF\"},\"border\":{\"radius\":\"12px\"}}} -->\n<div class=\"wp-block-column has-background\" style=\"border-radius:12px;background-color:#FFFFFF;padding-top:35px;padding-right:30px;padding-bottom:35px;padding-left:30px\">\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"42px\"}}} -->\n<p class=\"has-text-align-center\" style=\"font-size:42px\">🔍</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":3,\"style\":{\"typography\":{\"fontSize\":\"22px\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#C9A84C\"}}} -->\n<h3 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#C9A84C;font-size:22px;font-style:normal;font-weight:700\">Transparency First</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"color\":{\"text\":\"#333333\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#333333\">We provide clear, no-obligation cash offers. If our solution isn't the best fit for your situation, we'll be the first to tell you.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"style\":{\"spacing\":{\"padding\":{\"top\":\"35px\",\"bottom\":\"35px\",\"left\":\"30px\",\"right\":\"30px\"}},\"color\":{\"background\":\"#FFFFFF\"},\"border\":{\"radius\":\"12px\"}}} -->\n<div class=\"wp-block-column has-background\" style=\"border-radius:12px;background-color:#FFFFFF;padding-top:35px;padding-right:30px;padding-bottom:35px;padding-left:30px\">\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"42px\"}}} -->\n<p class=\"has-text-align-center\" style=\"font-size:42px\">🔨</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":3,\"style\":{\"typography\":{\"fontSize\":\"22px\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#C9A84C\"}}} -->\n<h3 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#C9A84C;font-size:22px;font-style:normal;font-weight:700\">No Repairs Needed</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"color\":{\"text\":\"#333333\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#333333\">You don't have to pick up a broom or spend a cent on renovations. We buy houses in any condition, exactly as they are today.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"style\":{\"spacing\":{\"padding\":{\"top\":\"35px\",\"bottom\":\"35px\",\"left\":\"30px\",\"right\":\"30px\"}},\"color\":{\"background\":\"#FFFFFF\"},\"border\":{\"radius\":\"12px\"}}} -->\n<div class=\"wp-block-column has-background\" style=\"border-radius:12px;background-color:#FFFFFF;padding-top:35px;padding-right:30px;padding-bottom:35px;padding-left:30px\">\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"42px\"}}} -->\n<p class=\"has-text-align-center\" style=\"font-size:42px\">🏡</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":3,\"style\":{\"typography\":{\"fontSize\":\"22px\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#C9A84C\"}}} -->\n<h3 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#C9A84C;font-size:22px;font-style:normal;font-weight:700\">Local Expertise</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"color\":{\"text\":\"#333333\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#333333\">We aren't a faceless national corporation. We understand the unique value of Wisconsin neighborhoods, from Ashwaubenon to De Pere.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n</div>\n<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"70px\",\"bottom\":\"70px\",\"left\":\"20px\",\"right\":\"20px\"}},\"color\":{\"background\":\"#0D3B2E\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1000px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#0D3B2E;padding-top:70px;padding-right:20px;padding-bottom:70px;padding-left:20px\">\n<!-- wp:heading {\"textAlign\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"36px\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#FFFFFF\"},\"spacing\":{\"margin\":{\"bottom\":\"15px\"}}}} -->\n<h2 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#FFFFFF;margin-bottom:15px;font-size:36px;font-style:normal;font-weight:700\">Expert Solutions for Difficult Situations</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"18px\"},\"color\":{\"text\":\"#F5F0E8\"},\"spacing\":{\"margin\":{\"bottom\":\"40px\"}}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#F5F0E8;margin-bottom:40px;font-size:18px\">When life gets complicated, we simplify the sale.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"17px\",\"lineHeight\":\"1.7\"},\"color\":{\"text\":\"#F5F0E8\"}}} -->\n<p class=\"has-text-color\" style=\"color:#F5F0E8;font-size:17px;line-height:1.7\"><strong style=\"color:#C9A84C\">📜 Probate &amp; Inherited Houses:</strong><br>We guide families through estate sales with compassion and respect for your timeline.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"17px\",\"lineHeight\":\"1.7\"},\"color\":{\"text\":\"#F5F0E8\"}}} -->\n<p class=\"has-text-color\" style=\"color:#F5F0E8;font-size:17px;line-height:1.7\"><strong style=\"color:#C9A84C\">🛡️ Foreclosure Avoidance:</strong><br>We act fast to help you stay ahead of the bank and protect your credit.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"17px\",\"lineHeight\":\"1.7\"},\"color\":{\"text\":\"#F5F0E8\"}}} -->\n<p class=\"has-text-color\" style=\"color:#F5F0E8;font-size:17px;line-height:1.7\"><strong style=\"color:#C9A84C\">🏚️ Distressed Properties:</strong><br>We buy houses with structural issues, mold, or major water damage — no fix-up required.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"17px\",\"lineHeight\":\"1.7\"},\"color\":{\"text\":\"#F5F0E8\"}}} -->\n<p class=\"has-text-color\" style=\"color:#F5F0E8;font-size:17px;line-height:1.7\"><strong style=\"color:#C9A84C\">🔑 Tired Landlords:</strong><br>We take over rental properties with difficult tenants or high vacancies.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n</div>\n<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"60px\",\"bottom\":\"60px\",\"left\":\"20px\",\"right\":\"20px\"}},\"color\":{\"background\":\"#1A1A1A\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#1A1A1A;padding-top:60px;padding-right:20px;padding-bottom:60px;padding-left:20px\">\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":3,\"style\":{\"typography\":{\"fontSize\":\"28px\",\"fontWeight\":\"700\"},\"color\":{\"text\":\"#FFFFFF\"}}} -->\n<h3 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#FFFFFF;font-size:28px;font-style:normal;font-weight:700\">Ready to get a fair offer for your house?</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"18px\"},\"color\":{\"text\":\"#C9A84C\"},\"spacing\":{\"margin\":{\"bottom\":\"30px\"}}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#C9A84C;margin-bottom:30px;font-size:18px\">No obligation. No pressure. Just an honest cash offer from neighbors you can trust.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"backgroundColor\":\"secondary\",\"textColor\":\"primary\",\"style\":{\"border\":{\"radius\":\"30px\"},\"typography\":{\"fontSize\":\"18px\",\"fontWeight\":\"700\"},\"spacing\":{\"padding\":{\"top\":\"16px\",\"bottom\":\"16px\",\"left\":\"36px\",\"right\":\"36px\"}}}} -->\n<div class=\"wp-block-button has-custom-font-size\" style=\"font-size:18px;font-style:normal;font-weight:700\"><a class=\"wp-block-button__link has-primary-color has-secondary-background-color has-text-color has-background has-link-color wp-element-button\" href=\"/contact/\" style=\"border-radius:30px;padding-top:16px;padding-right:36px;padding-bottom:16px;padding-left:36px\">Get My Cash Offer Now →</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n</div>\n<!-- /wp:group -->\n",
